# Production: generate a long random string and keep it private.
SECRET_KEY=replace-with-a-long-random-secret
# Set to 1 when deployed behind HTTPS.
COOKIE_SECURE=1
# Optional: instead of browser first-run setup, seed an admin from environment variables.
# ADMIN_USERNAME=eddy
# ADMIN_PASSWORD=use-a-long-unique-password
# Persistent SQLite location on a mounted disk, if your host uses ephemeral filesystems.
# PORTFOLIO_DB=/data/portfolio.db
